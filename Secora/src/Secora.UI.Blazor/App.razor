@page "/Secora"
@using Secora.Abstractions
@using Secora.UI.Blazor.Components
@inject IPluginManager PluginManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Secora</title>
    <link rel="stylesheet" href="_content/Secora.UI.Blazor/secora.css" />
    <base href="/" />
</head>
<body>
    <div class="secora-shell">

        <!-- ── Sidebar ── -->
        <aside class="secora-sidebar">

            <div class="sidebar-header">
                <span class="sidebar-logo">
                    <img src="_content/Secora.UI.Blazor/Logo.png" alt="Secora" />
                </span>
            </div>

            <!-- Nav: Main -->
            <nav class="sidebar-nav">
                <span class="sidebar-section-label">Main</span>
                <ul class="nav-list">
                    <li class="nav-item @(ActiveView == "dashboard" ? "active" : "")"
                        @onclick='() => Navigate("dashboard")'>
                        <!-- Tabler: layout-dashboard -->
                        <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="4" width="6" height="6" rx="1" />
                            <rect x="14" y="4" width="6" height="6" rx="1" />
                            <rect x="4" y="14" width="6" height="6" rx="1" />
                            <rect x="14" y="14" width="6" height="6" rx="1" />
                        </svg>
                        <span class="nav-label">Dashboard</span>
                    </li>
                </ul>

                <span class="sidebar-section-label">Plugins</span>
                <ul class="nav-list">
                    @if (!PluginManager.Plugins.Any())
                    {
                        <li class="plugin-empty">
                            <span class="plugin-empty-text">No plugins loaded</span>
                        </li>
                    }
                    else
                    {
                        @foreach (var plugin in PluginManager.Plugins)
                        {
                            var p = plugin;
                            <li class="nav-item @(ActiveView == p.Name ? "active" : "")"
                                @onclick="() => NavigatePlugin(p)">
                                <!-- Tabler: puzzle -->
                                <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 7h3a1 1 0 0 0 1 -1v-1a2 2 0 0 1 4 0v1a1 1 0 0 0 1 1h3a1 1 0 0 1 1 1v3a1 1 0 0 0 1 1h1a2 2 0 0 1 0 4h-1a1 1 0 0 0 -1 1v3a1 1 0 0 1 -1 1h-3a1 1 0 0 1 -1 -1v-1a2 2 0 0 0 -4 0v1a1 1 0 0 1 -1 1h-3a1 1 0 0 1 -1 -1v-3a1 1 0 0 0 -1 -1h-1a2 2 0 0 1 0 -4h1a1 1 0 0 0 1 -1v-3a1 1 0 0 1 1 -1z" />
                                </svg>
                                <span class="nav-item-info">
                                    <span class="plugin-item-name">@p.Name</span>
                                    <span class="plugin-item-version">v@p.Version</span>
                                </span>
                            </li>
                        }
                    }
                </ul>
            </nav>

            <div class="sidebar-footer">
                <a class="sidebar-github-link" href="https://github.com/ADHIL007/Secora" target="_blank" rel="noopener noreferrer">
                    <!-- Tabler: brand-github -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                    </svg>
                    <span>ADHIL007/Secora</span>
                </a>
            </div>

        </aside>

        <!-- ── Main content ── -->
        <main class="secora-main">
            @if (ActiveView == "dashboard")
            {
                <Dashboard />
            }
            else if (SelectedPlugin is not null)
            {
                <div class="main-header">
                    <h1 class="main-title">@(SelectedPlugin.Page?.Title ?? SelectedPlugin.Name)</h1>
                    <p class="main-subtitle">by @SelectedPlugin.Author &nbsp;·&nbsp; v@SelectedPlugin.Version</p>
                </div>

                @if (SelectedPlugin.Page?.ComponentType is Type componentType)
                {
                    <DynamicComponent Type="componentType" />
                }
                else
                {
                    <div class="plugin-detail-card">
                        <div class="card-header">
                            <div class="card-title-group">
                                <div class="card-title">@SelectedPlugin.Name</div>
                                <div class="card-author">by @SelectedPlugin.Author</div>
                            </div>
                            <span class="card-version-pill">v@SelectedPlugin.Version</span>
                        </div>
                        <p class="card-description">@SelectedPlugin.Description</p>
                    </div>
                }
            }
        </main>

    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>

@code {
    private string ActiveView { get; set; } = "dashboard";
    private ISecoraPlugin? SelectedPlugin { get; set; }

    private void Navigate(string view)
    {
        ActiveView = view;
        SelectedPlugin = null;
    }

    private void NavigatePlugin(ISecoraPlugin plugin)
    {
        SelectedPlugin = plugin;
        ActiveView = plugin.Name;
    }
}
